{
  "name": "homebridge-zz-shelly-doorbell",
  "version": "1.0.0",
  "description": "Plugin Homebridge pour Shelly Doorbell utilisant des webhooks (RPC)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p ./ && npm run move-media",
    "lint": "tsc -p ./ --noEmit",
    "test": "tsc -p ./ && node --test dist/*.test.js",
    "prepublishOnly": "npm run build",
    "move-media": "if [ -d ./media ]; then mv ./media ./dist/media; fi",
    "postinstall": "npm run build && npm run move-media"
  },
  "keywords": [
    "homebridge-plugin",
    "shelly",
    "doorbell",
    "homekit"
  ],
  "author": "Votre Nom",
  "license": "ISC",
  "peerDependencies": {
    "homebridge": "^2.0.0-beta.0"
  },
  "engines": {
    "node": ">=18.18.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "devDependencies": {
  },
  "dependencies": {
    "pick-port": "^2.1.0",
    "suncalc": "^1.9.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/suncalc": "^1.9.2"
  }
}